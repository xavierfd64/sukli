# Fallback for shared-hosting accounts where the document root cannot be
# changed to /public (e.g. Z.com "public_html" only). If your hosting panel
# lets you point the domain's document root directly at /public, this file
# is not needed and can be left in place harmlessly.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^$ public/ [L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule (.*) public/$1 [L]
</IfModule>

# Block direct access to everything else in the project root.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
