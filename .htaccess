RewriteEngine On

# Security headers (works on Apache mod_headers, common on shared hosting)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Belt-and-suspenders: block any dotfile (.env, .git*, etc.) even if a
# subdirectory's own .htaccess isn't being honored for some reason. The real
# protection for secrets is that config/installed.php is a PHP file (Apache
# executes it rather than serving its contents), not this rule — but this
# costs nothing and helps wherever .htaccess overrides do work.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Serve existing files/directories (assets) directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else goes through the front controller
RewriteRule ^ index.php [L]
